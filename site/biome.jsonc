{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    // Generated: responsive images and GPU textures come out of `pnpm images`,
    // the GitHub counts out of `pnpm github`.
    "includes": ["**", "!dist", "!public", "!src/data/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // The engine holds GPU handles that only exist after init().
        "noNonNullAssertion": "off"
      },
      "correctness": {
        // The scroll loop reads the DOM once on mount and has no reactive deps.
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        // These lists are static content, fixed at build time, so index is stable.
        "noArrayIndexKey": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
